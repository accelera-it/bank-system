# Environment of demo/docker-compose.yml. Development defaults only: do not put real secrets here.

ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL (pg)
POSTGRES_DB=DemoShop
POSTGRES_USER=demoshop
POSTGRES_PASSWORD=Ab17f9b40f9b28672ab9b43

# Redis (shop-redis)
REDIS_PASSWORD=Ab1c07bc14a46530d55c686

# DemoShop (demo)
ConnectionStrings__DemoShop="Host=pg;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
ConnectionStrings__Redis="shop-redis:6379,password=${REDIS_PASSWORD}"
DirectPaymentsConfiguration__SiteUrl=http://localhost:8082/
DirectPaymentsConfiguration__CentralApiPaymentUrl=http://localhost:8080/pay
CardPaymentsConfiguration__CentralApiCardPaymentsUrl=http://api:5000/api/CardPayments
DestinationBankAccountConfiguration__DestinationBankAccountUniqueId=ABCJ98131785
DestinationBankAccountConfiguration__RecipientName="ABS Admin"
