@model CardPaymentBindingModel

@{
    ViewData["Title"] = "Card payment";
}

<div class="w-50 my-4">
    <h3 class="mb-4">@ViewData["Title"]</h3>
    <h4>@Model.ProductName</h4>
    <h2>@Model.ProductPrice UZS</h2>
    <form method="post">
        <hr/>
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Number"></label>
            <input class="form-control" asp-for="Number" placeholder="16-digit card number"/>
            <span asp-validation-for="Number" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Name"></label>
            <input class="form-control" asp-for="Name" placeholder="Name on the card"/>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="form-group col">
                <label asp-for="ExpiryDate"></label>
                <input class="form-control" asp-for="ExpiryDate" placeholder="MM/YY"/>
                <span asp-validation-for="ExpiryDate" class="text-danger"></span>
            </div>
            <div class="form-group col">
                <label asp-for="SecurityCode"></label>
                <input class="form-control" asp-for="SecurityCode" placeholder="123"/>
                <span asp-validation-for="SecurityCode" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <a class="btn btn-outline-secondary" asp-controller="Orders" asp-action="My"><i class="fas fa-times mr-1" aria-hidden="true"></i> Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="fas fa-credit-card mr-1" aria-hidden="true"></i> Pay</button>
        </div>
    </form>
</div>