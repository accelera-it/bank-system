{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Routes": [
    {
      "UpstreamPathTemplate": "/api/static/{everything}",
      "DownstreamPathTemplate": "/static/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "bank_central",
          "Port": 5000
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/bank/api/{everything}",
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "bank_web",
          "Port": 5000
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/pay",
      "DownstreamPathTemplate": "/pay",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "bank_central",
          "Port": 5000
        }
      ],
      "UpstreamHeaderTransform": {
        "X-Forwarded-Prefix": "/api"
      }
    },
    {
      "UpstreamPathTemplate": "/api/pay/continue",
      "DownstreamPathTemplate": "/pay/continue",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "bank_central",
          "Port": 5000
        }
      ],
      "UpstreamHeaderTransform": {
        "X-Forwarded-Prefix": "/api"
      }
    },
    {
      "UpstreamPathTemplate": "/api/swagger/{everything}",
      "DownstreamPathTemplate": "/swagger/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "bank_central",
          "Port": 5000
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/{everything}",
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "bank_central",
          "Port": 5000
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8081"
  },
  "RateLimit": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  }
}
