# Environment of every docker-compose.yml service. WEB_PORT and DEMO_PORT also set the
# published ports, so pass the file on every command too:
#   docker compose --env-file locale.env up --build
# Development defaults only: do not put real secrets here.

# Shared
ASPNETCORE_ENVIRONMENT=Production
MSSQL_SA_PASSWORD=BankSystem_Dev123!

# Published ports
WEB_PORT=8080
DEMO_PORT=8082

# CentralApi (api)
ConnectionStrings__CentralApi="Server=db,1433;Database=BankSystemCentralApi;User Id=sa;Password=${MSSQL_SA_PASSWORD};MultipleActiveResultSets=true;TrustServerCertificate=True"
DefaultBankBaseUrl=http://web

# BankSystem.Web (web)
ConnectionStrings__BankSystem="Server=db,1433;Database=BankSystem;User Id=sa;Password=${MSSQL_SA_PASSWORD};MultipleActiveResultSets=true;TrustServerCertificate=True"
BankConfiguration__CentralApiAddress=http://api/

# DemoShop (demo)
ConnectionStrings__DemoShop="Server=db,1433;Database=DemoShop;User Id=sa;Password=${MSSQL_SA_PASSWORD};MultipleActiveResultSets=true;TrustServerCertificate=True"
DirectPaymentsConfiguration__SiteUrl=http://localhost:${DEMO_PORT}/
DirectPaymentsConfiguration__CentralApiPaymentUrl=http://localhost:8081/pay
CardPaymentsConfiguration__CentralApiCardPaymentsUrl=http://api/api/CardPayments
DestinationBankAccountConfiguration__DestinationBankAccountUniqueId=ABCJ98131785
DestinationBankAccountConfiguration__RecipientName="ABS Admin"
