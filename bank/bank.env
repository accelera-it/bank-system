# CentralApi
ConnectionStrings__CentralApi="User Id=centralapi;Password=${CENTRALAPI_DB_PASSWORD};Data Source=bank_oracle:1521/FREEPDB1"
CentralApiConfiguration__Key="<RSAKeyValue><Modulus></Modulus><Exponent>AQAB</Exponent><P></P><Q></Q><DP></DP><DQ></DQ><InverseQ></InverseQ><D></D></RSAKeyValue>"

# CentralApi: default bank seeded on first start
DefaultBankBaseUrl=http://bank_api:5000/bank
DefaultBankPublicUrl=http://localhost:8081

# BankSystem.Web
ConnectionStrings__BankSystem="User Id=banksystem;Password=${BANK_DB_PASSWORD};Data Source=bank_oracle:1521/FREEPDB1"
ConnectionStrings__Redis="bank_redis:6379,password=${REDIS_PASSWORD}"

