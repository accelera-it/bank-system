# Environment of every docker-compose.yml service. API_PORT, WEB_PORT and DEMO_PORT also set the
# published ports, so pass the file on every command too:
#   docker compose --env-file locale.env up --build
# Development defaults only: do not put real secrets here.

# Shared
ASPNETCORE_ENVIRONMENT=Production
MSSQL_SA_PASSWORD=2kGuRaJUGOquy2FE

# CentralApi (api)
ConnectionStrings__CentralApi="Server=db,1433;Database=BankSystemCentralApi;User Id=sa;Password=${MSSQL_SA_PASSWORD};MultipleActiveResultSets=true;TrustServerCertificate=True"
DefaultBankBaseUrl=http://web:5000
