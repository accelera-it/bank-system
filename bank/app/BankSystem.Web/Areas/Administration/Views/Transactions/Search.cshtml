@{
    ViewData["Title"] = "Look up transaction";
}

<div class="container">
    <div class="panel panel-form">
        <form method="get" asp-action="Result" asp-controller="Transactions">
            <div class="form-group">
                <label>Reference number</label>
                <input required class="form-control" name="referenceNumber" placeholder="Enter the reference number" />
            </div>
            <div class="form-group">
                <button class="btn btn-primary" type="submit"><i class="fas fa-search mr-1" aria-hidden="true"></i> Search</button>
            </div>
        </form>
    </div>
</div>