@model InternalMoneyTransferCreateBindingModel

@{
    ViewData["Title"] = "Create internal money transfer";
}

<div class="my-4 w-lg-50 w-md-75">
    <h2>@ViewData["Title"]</h2>
    <form method="post">
        <hr />
        <div class="form-group">
            <label asp-for="AccountId"></label>
            <select class="custom-select form-control" asp-for="AccountId">
                <option disabled selected>Select source account...</option>
                @foreach (var account in Model.OwnAccounts)
                {
                    <option value="@account.Id">@account.Name - @account.Balance.ToString("F2") UZS</option>
                }
            </select>
            <span asp-validation-for="AccountId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="DestinationBankAccountUniqueId"></label>
            <input class="form-control" asp-for="DestinationBankAccountUniqueId" id="destination" placeholder="e.g. ABCJ98131785" />
            <span asp-validation-for="DestinationBankAccountUniqueId" class="text-danger"></span>
            @if (Model.OwnAccounts.Count() > 1)
            {
                <select class="custom-select form-control mt-3 text-muted" id="ownAccountPicker">
                    <option disabled selected>...or choose another one of your accounts</option>
                    @foreach (var account in Model.OwnAccounts)
                    {
                        <option value="@account.UniqueId">@account.Name - @account.Balance.ToString("F2") UZS</option>
                    }
                </select>
            }
        </div>
        <div class="form-group">
            <label asp-for="Amount"></label>
            <div class="input-group mb-2">
                <div class="input-group-prepend">
                    <div class="input-group-text">UZS</div>
                </div>
                <input type="number" min="0.01" step="0.01" class="form-control" asp-for="Amount" placeholder="0.00" />
            </div>
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Description">
                Description
                <span class="font-italic text-muted">(optional)</span>
            </label>
            <input class="form-control" asp-for="Description" placeholder="What is this transfer for?" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="form-group">
            <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary"><i class="fas fa-times mr-1" aria-hidden="true"></i> Cancel</a>
            <button class="btn btn-primary" type="submit"><i class="fas fa-credit-card mr-1" aria-hidden="true"></i> Pay</button>
        </div>
    </form>
</div>

@section Scripts
{
    @if (Model.OwnAccounts.Count() > 1)
    {
        <script>
            $('#ownAccountPicker').change(function() {
                $('#destination').val(this.value);
            });

            $('#destination').change(function() {
                $("#ownAccountPicker")[0].selectedIndex = 0;
            });
        </script>
    }
}