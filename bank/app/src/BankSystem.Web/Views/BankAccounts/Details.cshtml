@model BankAccountDetailsViewModel
@{
    ViewData["Title"] = Model.UniqueId;
}

<div class="row">
    <div class="col-12 col-lg-4 mb-3">
        <div class="stat stat-primary hover-parent">
            <span class="stat-label">
                <span id="accountName">@Model.Name</span>
                <i class="fas fa-pen fa-xs cursor-pointer hover-visible"
                   data-toggle="modal" data-target="#editModal">
                </i>
            </span>
            <span class="stat-value">@Model.Balance.ToString("N2") UZS</span>
            <span class="stat-label mt-3 mb-0">@Model.UniqueId</span>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-4 mb-3">
        <section class="panel h-100 mb-0">
            <h2 class="panel-title mb-2">Account details</h2>
            <dl class="detail-list">
                <div><dt>Name</dt><dd>@Model.UserFullName</dd></div>
                <div><dt>Date of creation</dt><dd class="auto-format-date">@Model.CreatedOn.ToString("O")</dd></div>
                <div><dt>Total transfers</dt><dd>@Model.MoneyTransfersCount</dd></div>
            </dl>
        </section>
    </div>
    <div class="col-12 col-md-6 col-lg-4 mb-3">
        <section class="panel h-100 mb-0">
            <h2 class="panel-title mb-2">Transfer information</h2>
            <dl class="detail-list">
                <div><dt>Account</dt><dd>@Model.UniqueId</dd></div>
                <div><dt>Bank name</dt><dd>@Model.BankName</dd></div>
                <div><dt>Bank country</dt><dd>@Model.BankCountry</dd></div>
                <div><dt>Bank code</dt><dd>@Model.BankCode</dd></div>
            </dl>
        </section>
    </div>
</div>

<section class="panel panel-table">
    <div class="panel-header">
        <h2 class="panel-title">Last transfers</h2>
    </div>
    @if (Model.MoneyTransfers.Any())
    {
        <partial name="_TransfersTable" model="@Model.MoneyTransfers" />
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-exchange-alt" aria-hidden="true"></i>
            No money transfers have been made yet.
        </div>
    }
</section>

@if (Model.MoneyTransfers.Any())
{
    <partial name="_PaginationPartial" model="@Model.MoneyTransfers" />
}

<div id="editModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit account display name</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form method="post">
                    <input type="hidden" name="accountId" value="@Model.Id">
                    <div class="form-group">
                        <label>Name</label>
                        <input required class="form-control" type="text" name="name" placeholder="e.g. Savings">
                    </div>
                    <div class="text-center d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary mr-auto" data-dismiss="modal"><i class="fas fa-times mr-1" aria-hidden="true"></i> Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-check mr-1" aria-hidden="true"></i> OK</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $('#editModal').on('show.bs.modal',
            function() {
                let modal = $(this);
                let name = $('#accountName').text();

                modal.find('.modal-body input[name=name]').val(name);
            });

        $('#editModal').on('shown.bs.modal',
            function() {
                $(this).find('.modal-body input[name=name]').trigger('focus');
            });

        $('#editModal form').submit(function(event) {
            event.preventDefault();

            $.ajax({
                url: '@Url.Action("ChangeAccountNameAsync", "BankAccounts")',
                type: 'post',
                data: $(event.target).serialize()

            }).always(function() {
                $('#editModal').modal('hide');
            }).done(function(response) {
                if (!response.success) {
                    return;
                }

                let newName = $('#editModal input[name=name]').val();

                $('#accountName').text(newName);
            });
        });
    </script>
}