@model CardCreateViewModel

@if (Model.BankAccounts.Any())
{
    <form asp-area="Cards" asp-controller="Cards" asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="AccountId"></label>
            <select class="custom-select" asp-for="AccountId" asp-items="Model.BankAccounts" required>
                <option value="" disabled selected>Select an account...</option>
            </select>
        </div>
        <button class="btn btn-primary btn-block" type="submit"><i class="fas fa-plus mr-1" aria-hidden="true"></i> Create</button>
    </form>
}
else
{
    <p>You need a bank account before you can issue a card.</p>
    <a class="btn btn-primary btn-block" asp-area="" asp-controller="BankAccounts" asp-action="Create"><i class="fas fa-plus mr-1" aria-hidden="true"></i> Create an account</a>
}
