# BankSystem.Web (web)
ConnectionStrings__BankSystem="User Id=banksystem;Password=${BANK_DB_PASSWORD};Data Source=oracle:1521/FREEPDB1"
ConnectionStrings__Redis="bank-redis:6379,password=${REDIS_PASSWORD}"
BankConfiguration__CentralApiAddress=http://api:5000/
