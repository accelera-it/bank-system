@model CardCreateViewModel

@{
    ViewData["Title"] = "Create card";
}

<div class="my-4 w-lg-50 w-md-75">
    <h2>@ViewData["Title"]</h2>
    <form method="post">
        <hr />
        <div class="form-group">
            <label asp-for="AccountId">
            </label>
            <select class="custom-select" asp-for="AccountId" asp-items="Model.BankAccounts">
                <option disabled selected>Select an account...</option>
            </select>
            <span asp-validation-for="AccountId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <a asp-action="Create" asp-controller="Cards" class="btn btn-outline-secondary"><i class="fas fa-times mr-1" aria-hidden="true"></i> Cancel</a>
            <button class="btn btn-primary" type="submit"><i class="fas fa-plus mr-1" aria-hidden="true"></i> Create</button>
        </div>
    </form>
</div>