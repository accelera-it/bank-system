@page
@{
    ViewData["Title"] = "New transfer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12 col-md-6 mb-3">
        <a class="transfer-option" asp-area="MoneyTransfers" asp-controller="Internal" asp-action="Create">
            <span class="quick-action-icon"><i class="fas fa-university" aria-hidden="true"></i></span>
            <h5>Internal transfer</h5>
            <p>Between two accounts in this bank, including your own accounts.</p>
        </a>
    </div>
    <div class="col-12 col-md-6 mb-3">
        <a class="transfer-option" asp-area="MoneyTransfers" asp-controller="Global" asp-action="Create">
            <span class="quick-action-icon"><i class="fas fa-globe" aria-hidden="true"></i></span>
            <h5>Worldwide transfer</h5>
            <p>To an account in another bank.</p>
        </a>
    </div>
</div>
