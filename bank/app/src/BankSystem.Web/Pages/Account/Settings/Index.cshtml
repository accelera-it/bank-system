@page
@model IndexModel
@{
    ViewData["Title"] = "Account settings";
}

<div class="row">
    <div class="col-12 col-lg-7 mb-3">
        <section class="panel h-100 mb-0">
            <span class="profile-avatar"><i class="fas fa-user" aria-hidden="true"></i></span>
            <h2 class="panel-title">@Model.FullName</h2>
            <p class="text-muted">@Model.Email</p>
            <a class="btn btn-outline-primary" href="@Model.AccountUrl">
                <i class="fas fa-key mr-1" aria-hidden="true"></i> Password and security
            </a>
        </section>
    </div>
</div>
