@page
@model Disable2faModel
@{
    ViewData["Title"] = "Disable two-factor authentication";
}

<div class="panel panel-form">
    <p>
        To disable two-factor authentication, please enter the verification code
        from your authenticator app and your password
    </p>
    <form method="post" class="form-group">
        <div class="form-group">
            <label asp-for="Input.Code"></label>
            <input asp-for="Input.Code" class="form-control" placeholder="6-digit code"/>
            <span asp-validation-for="Input.Code" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" class="form-control" placeholder="Enter your password"/>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <a class="btn btn-outline-primary" asp-page="./Index">
            <i class="fas fa-chevron-left"></i>
            Cancel
        </a>
        <button class="btn btn-danger" type="submit"><i class="fas fa-lock-open mr-1" aria-hidden="true"></i> Disable 2FA</button>
    </form>
</div>