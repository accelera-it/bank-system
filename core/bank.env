# Environment of core/docker-compose.yml. Development defaults only: do not put real secrets here.

ASPNETCORE_ENVIRONMENT=Production

# Oracle (oracle)
ORACLE_PASSWORD=Ab120bd00ea528fb4cd2389
BANK_DB_PASSWORD=Ab16e455fdcbc6f439df152
CENTRALAPI_DB_PASSWORD=Ab1ca7f93f9787cc7941b6a

# Redis (bank-redis)
REDIS_PASSWORD=Ab16264a0910bc253715946

# CentralApi (api)
ConnectionStrings__CentralApi="User Id=centralapi;Password=${CENTRALAPI_DB_PASSWORD};Data Source=oracle:1521/FREEPDB1"
