@page
@model SendEmailVerificationModel

@{
    ViewData["Title"] = "Send email verification link";
}

<div class="container">
    <div>
        <div class="text-left">
            <a class="btn btn-link" asp-page="/Account/Login">
                <i class="fas fa-chevron-left"></i>
                Back to login page
            </a>
        </div>
        <h2>@ViewData["Title"]</h2>

        <form class="w-md-75 w-lg-50 my-4" method="post">
            <hr />
            <div class="form-group">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane mr-1" aria-hidden="true"></i> Send</button>
        </form>
    </div>
</div>
