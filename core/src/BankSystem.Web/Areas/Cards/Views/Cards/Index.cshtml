@model CardListingViewModel

@{
    ViewData["Title"] = "Your cards";
}

<div>
    @if (Model.Cards.Any())
    {
        <div class="row">
            @foreach (var card in Model.Cards)
            {
                <div class="col-12 col-md-6 col-xl-4 mb-4">
                    <div class="bank-card">
                        <div class="bank-card-top">
                            <span>@card.AccountName</span>
                            <i class="fas fa-wifi fa-rotate-90" aria-hidden="true"></i>
                        </div>
                        <div class="bank-card-number">@System.Text.RegularExpressions.Regex.Replace(card.Number, ".{4}", "$0 ")</div>
                        <div class="bank-card-meta">
                            <div><span>Cardholder</span>@card.Name</div>
                            <div><span>Expires</span>@card.ExpiryDate</div>
                            <div><span>CVV</span>@card.SecurityCode</div>
                        </div>
                    </div>
                    <button class="btn btn-link btn-sm text-danger mt-2 px-0" data-toggle="modal"
                            data-target="#deleteModal" data-id="@card.Id">
                        <i class="fas fa-trash-alt mr-1" aria-hidden="true"></i> Delete
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <div class="panel empty-state">
            <i class="fas fa-credit-card" aria-hidden="true"></i>
            <p>You don't have any cards.</p>
            <a asp-action="Create" asp-controller="Cards" class="btn btn-primary"><i class="fas fa-plus mr-1" aria-hidden="true"></i> Create card</a>
        </div>
    }
</div>

<div class="fade modal" id="deleteModal" role="dialog" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Are you sure you want to delete this card?</h5>
                <button aria-label="Close" class="close" data-dismiss="modal" type="button">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-dismiss="modal" type="button"><i class="fas fa-times mr-1" aria-hidden="true"></i> Close</button>
                <form asp-action="Delete" asp-controller="Cards" method="post">
                    <input name="id" type="hidden">
                    <button class="btn btn-danger" type="submit"><i class="fas fa-trash-alt mr-1" aria-hidden="true"></i> Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.Cards.Any())
{
    <partial name="_PaginationPartial" model="@Model.Cards" />
}

@section Scripts{
    <script>
        $('#deleteModal').on('show.bs.modal',
            function(event) {
                const button = $(event.relatedTarget);
                const key = button.data('id');
                const modal = $(this);
                modal.find('.modal-footer input[name=id]').val(key);
            })
    </script>
}