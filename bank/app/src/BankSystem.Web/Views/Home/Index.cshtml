@model HomeViewModel
@{
    ViewData["Title"] = "Dashboard";
}
@{
    var totalBalance = Model.UserBankAccounts.Sum(a => a.Balance);
    var incoming = Model.MoneyTransfers.Where(t => t.Amount > 0).Sum(t => t.Amount);
    var outgoing = Model.MoneyTransfers.Where(t => t.Amount < 0).Sum(t => -t.Amount);
}

<div>
    <div class="row">
        <div class="col-12 col-lg-6 col-xl-4 mb-3">
            <div class="stat stat-primary">
                <span class="stat-label">Total balance</span>
                <span class="stat-value">@totalBalance.ToString("N2") UZS</span>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3 col-xl-2 mb-3">
            <div class="stat">
                <span class="stat-label">Accounts</span>
                <span class="stat-value">@Model.UserBankAccounts.Count()</span>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3 mb-3">
            <div class="stat">
                <span class="stat-label">Incoming, last 10 transfers</span>
                <span class="stat-value text-green">@(incoming > 0 ? "+" : string.Empty)@incoming.ToString("N2")</span>
            </div>
        </div>
        <div class="col-12 col-lg-6 col-xl-3 mb-3">
            <div class="stat">
                <span class="stat-label">Outgoing, last 10 transfers</span>
                <span class="stat-value text-red">@(outgoing > 0 ? "-" : string.Empty)@outgoing.ToString("N2")</span>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12 col-md-4 mb-3">
            <a class="quick-action" asp-page="/MoneyTransfers">
                <span class="quick-action-icon"><i class="fas fa-exchange-alt" aria-hidden="true"></i></span>
                <span>New transfer<small>Inside or outside the bank</small></span>
            </a>
        </div>
        <div class="col-12 col-md-4 mb-3">
            <a class="quick-action" data-card-modal="New card" asp-area="Cards" asp-controller="Cards" asp-action="Create">
                <span class="quick-action-icon"><i class="fas fa-credit-card" aria-hidden="true"></i></span>
                <span>New card<small>For any of your accounts</small></span>
            </a>
        </div>
        <div class="col-12 col-md-4 mb-3">
            <a class="quick-action" asp-controller="BankAccounts" asp-action="Create">
                <span class="quick-action-icon"><i class="fas fa-wallet" aria-hidden="true"></i></span>
                <span>New account<small>Open another account</small></span>
            </a>
        </div>
    </div>

    <div class="row flex-lg-row-reverse">
        <div class="col-12 col-lg-4">
            <section class="panel">
                <div class="panel-header">
                    <h2 class="panel-title">Your accounts</h2>
                </div>
                @foreach (var account in Model.UserBankAccounts)
                {
                    <div class="account-row hover-parent">
                        <div>
                            <p>
                                <a asp-controller="BankAccounts" asp-action="Details" asp-route-id="@account.Id">@account.Name</a>
                                <i class="fas fa-pen ml-1 cursor-pointer hover-visible text-muted text-primary-hover"
                                   data-toggle="modal" data-target="#editModal" data-id="@account.Id">
                                </i>
                            </p>
                            <small>@account.UniqueId</small>
                        </div>
                        <p class="amount">@account.Balance.ToString("N2") UZS</p>
                    </div>
                }
            </section>
        </div>
        <div class="col-12 col-lg-8">
            <section class="panel panel-table">
                <div class="panel-header">
                    <h2 class="panel-title">Last 10 transfers</h2>
                    @if (Model.MoneyTransfers.Any())
                    {
                        <a asp-area="MoneyTransfers" asp-controller="Home" asp-action="All">View all</a>
                    }
                </div>
                @if (Model.MoneyTransfers.Any())
                {
                    <partial name="_TransfersTable" model="@Model.MoneyTransfers" />
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-exchange-alt" aria-hidden="true"></i>
                        No transfers have been made yet.
                    </div>
                }
            </section>
        </div>
    </div>

    <div id="editModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit account display name</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form method="post">
                        <input type="hidden" name="accountId">
                        <div class="form-group">
                            <label>Name</label>
                            <input required class="form-control" type="text" name="name" placeholder="e.g. Savings">
                        </div>
                        <div class="text-center d-flex justify-content-between">
                            <button type="button" class="btn btn-secondary mr-auto" data-dismiss="modal"><i class="fas fa-times mr-1" aria-hidden="true"></i> Cancel</button>
                            <button type="submit" class="btn btn-primary"><i class="fas fa-check mr-1" aria-hidden="true"></i> OK</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $('#editModal').on('show.bs.modal',
            function(event) {
                let button = $(event.relatedTarget);
                let id = button.data('id');
                let modal = $(this);
                modal.find('.modal-body input[name=accountId]').val(id);

                let name = button.parent().find('a').text();

                modal.find('.modal-body input[name=name]').val(name);
            });

        $('#editModal').on('shown.bs.modal',
            function() {
                $(this).find('.modal-body input[name=name]').trigger('focus');
            });

        $('#editModal form').submit(function(event) {
            event.preventDefault();

            $.ajax({
                url: '@Url.Action("ChangeAccountNameAsync", "BankAccounts")',
                type: 'post',
                data: $(event.target).serialize()

            }).always(function() {
                $('#editModal').modal('hide');
            }).done(function(response) {
                if (!response.success) {
                    return;
                }

                let accountId = $('#editModal input[name=accountId]').val();
                let newName = $('#editModal input[name=name]').val();

                $(`i[data-id=${accountId}]`).parent().find('a').text(newName);
            });
        });
    </script>
}