@page
@model LogoutModel
@{
    ViewData["Title"] = "Logout";
}

<div class="panel panel-form">
    <form method="post">
        <p>Click this button to log out</p>
        <div class="form-group">
            <button type="submit" class="btn btn-primary"><i class="fas fa-sign-out-alt mr-1" aria-hidden="true"></i> Logout</button>
        </div>
    </form>
</div>