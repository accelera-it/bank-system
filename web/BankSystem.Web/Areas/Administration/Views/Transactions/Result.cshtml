@model TransactionListingViewModel
@{
    ViewData["Title"] = "Results";
}

<section class="panel panel-table">
    <div class="panel-header">
        <h2 class="panel-title">Reference number @Model.ReferenceNumber</h2>
        <a asp-action="Search"><i class="fas fa-search mr-1" aria-hidden="true"></i> New search</a>
    </div>
    @if (Model.MoneyTransfers.Any())
    {
        <partial name="_TransfersTable" model="@Model.MoneyTransfers" />
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-search" aria-hidden="true"></i>
            No money transfers with this reference number were found.
        </div>
    }
</section>
