@inject Microsoft.AspNetCore.Identity.UserManager<BankSystem.Models.BankUser> Users
@{
    var authenticated = User.Identity.IsAuthenticated;
    var routeArea = ViewContext.RouteData.Values["area"] as string ?? string.Empty;
    var routeController = ViewContext.RouteData.Values["controller"] as string;
    var routeAction = ViewContext.RouteData.Values["action"] as string;
    var routePage = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
    var fullName = authenticated ? (await Users.GetUserAsync(User))?.FullName : null;
    var IsTransferCreation = routePage == "/MoneyTransfers"
        || (routeArea == "MoneyTransfers" && routeController != "Home");

    string NavClass(string area, string controller, string action = null)
        => routeArea == area && routeController == controller && (action == null || routeAction == action)
            ? "active"
            : string.Empty;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bank System</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logo.svg" asp-append-version="true" />

    <link rel="stylesheet" href="~/bundle/vendor.min.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.7.2/css/all.css"
          integrity="sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr" crossorigin="anonymous">

    <link rel="stylesheet" href="~/bundle/main.min.css" asp-append-version="true" />

    @RenderSection("CustomCss", false)

</head>
<body class="@(authenticated ? "app-body" : string.Empty)">
    <div class="@(authenticated ? "app-shell" : string.Empty)">
    @if (authenticated)
    {
        <aside class="app-sidebar" id="appSidebar">
            <a class="app-sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/img/brand.svg" alt="Bank" width="145" height="54" asp-append-version="true" />
            </a>

            <nav aria-label="Main">
                <div class="app-nav-heading">Overview</div>
                <a class="app-nav-link @NavClass("", "Home")" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-th-large" aria-hidden="true"></i> Dashboard
                </a>

                <div class="app-nav-heading">Transfers</div>
                <a class="app-nav-link @(IsTransferCreation ? "active" : string.Empty)" asp-area="" asp-page="/MoneyTransfers">
                    <i class="fas fa-exchange-alt" aria-hidden="true"></i> New transfer
                </a>
                <a class="app-nav-link @NavClass("MoneyTransfers", "Home")" asp-area="MoneyTransfers" asp-controller="Home" asp-action="All">
                    <i class="fas fa-history" aria-hidden="true"></i> History
                </a>

                <div class="app-nav-heading">Cards</div>
                <a class="app-nav-link @NavClass("Cards", "Cards", "Index")" asp-area="Cards" asp-controller="Cards" asp-action="Index">
                    <i class="fas fa-credit-card" aria-hidden="true"></i> Your cards
                </a>
                <a class="app-nav-link" data-card-modal="New card" asp-area="Cards" asp-controller="Cards" asp-action="Create">
                    <i class="fas fa-plus" aria-hidden="true"></i> New card
                </a>

                @if (User.IsInRole(GlobalConstants.AdministratorRoleName))
                {
                    <div class="app-nav-heading">Administration</div>
                    <a class="app-nav-link @NavClass("Administration", "Accounts")" asp-area="Administration" asp-controller="Accounts" asp-action="Index">
                        <i class="fas fa-users" aria-hidden="true"></i> All accounts
                    </a>
                    <a class="app-nav-link @NavClass("Administration", "Transactions")" asp-area="Administration" asp-controller="Transactions" asp-action="Search">
                        <i class="fas fa-search" aria-hidden="true"></i> Look up transfer
                    </a>
                }

                <div class="app-nav-heading">Settings</div>
                <a class="app-nav-link" asp-area="" asp-page="/Account/Profile" asp-route-returnUrl="/updated.html" onclick="window.open(this.href, 'kyc', 'popup,width=560,height=760'); return false;">
                    <i class="fas fa-user-edit" aria-hidden="true"></i> Edit profile
                </a>
                <a class="app-nav-link" asp-area="" asp-page="/Account/Password" asp-route-returnUrl="/updated.html" onclick="window.open(this.href, 'kyc', 'popup,width=560,height=760'); return false;">
                    <i class="fas fa-key" aria-hidden="true"></i> Change password
                </a>
            </nav>

            <div class="app-sidebar-footer">
                <p class="font-weight-bold text-truncate mb-2 px-2">@fullName</p>
                <form asp-page="/Account/Logout" method="post">
                    <button type="submit" class="btn btn-danger btn-block">
                        <i class="fas fa-sign-out-alt mr-1" aria-hidden="true"></i> Log out
                    </button>
                </form>
            </div>
        </aside>
    }
    <div class="@(authenticated ? "app-main" : string.Empty)">
    <header>
        @if (authenticated)
        {
            <div class="app-topbar">
                <button type="button" class="app-sidebar-toggle" id="appSidebarToggle" aria-label="Toggle navigation">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                </button>
                <h1 class="app-topbar-title">@ViewData["Title"]</h1>
            </div>
        }

        @if (TempData.ContainsKey(GlobalConstants.TempDataSuccessMessageKey))
        {
            <div class="alert alert-primary fade show mb-0" role="alert">
                <div class="container d-flex flex-row">
                    <i class="fas fa-check fa-2x align-self-center"></i>
                    <p class="pl-3 my-2" style="font-size: large;">@TempData[GlobalConstants.TempDataSuccessMessageKey]</p>
                    <div class="ml-auto">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (TempData.ContainsKey(GlobalConstants.TempDataErrorMessageKey))
        {
            <div class="alert alert-danger fade show mb-0" role="alert">
                <div class="container d-flex flex-row">
                    <i class="fas fa-exclamation-circle fa-2x align-self-center"></i>
                    <p class="pl-3 my-2" style="font-size: large;">@TempData[GlobalConstants.TempDataErrorMessageKey]</p>
                    <div class="ml-auto">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
            </div>
        }

    </header>

    @RenderSection("UnderNavbar", false)

    <div class="@(authenticated ? string.Empty : "container")">
        <main role="main" class="@(authenticated ? "app-content" : "py-4")">
            @RenderBody()
        </main>
    </div>
    </div>
    </div>

    <script src="~/bundle/vendor.min.js" asp-append-version="true"></script>
    <script src="~/bundle/main.min.js" asp-append-version="true"></script>

    @if (authenticated)
    {
        <div class="modal fade" id="cardModal" tabindex="-1" role="dialog" aria-labelledby="cardModalTitle">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="cardModalTitle"></h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body" id="cardModalBody"></div>
                </div>
            </div>
        </div>

        <script>
            $('#appSidebarToggle').click(function () {
                $('#appSidebar').toggleClass('open');
            });

            $(document).on('click', '[data-card-modal]', function (event) {
                event.preventDefault();

                var url = this.href;
                $('#cardModalTitle').text($(this).data('cardModal'));
                $('#cardModalBody').load(url, function (response, status) {
                    if (status === 'error') {
                        window.location.href = url;
                        return;
                    }

                    $('#appSidebar').removeClass('open');
                    $('#cardModal').modal('show');
                });
            });
        </script>
    }

    @RenderSection("Scripts", false)
</body>
</html>
