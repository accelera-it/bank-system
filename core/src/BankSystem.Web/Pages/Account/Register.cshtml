@page
@model RegisterModel
@{
    ViewData["Title"] = "Create account";
}
<div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5">
        <div class="text-center mb-4">
            <a asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo.svg" alt="Bank System" width="56" height="56" asp-append-version="true" />
            </a>
            <h2 class="mt-3 mb-0">@ViewData["Title"]</h2>
        </div>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-group">
                        <label for="FullName">Full Name</label>
                        <input id="FullName" class="form-control" type="text" name="Input.FullName" value="@Model.Input?.FullName" placeholder="e.g. Aziz Karimov" autocomplete="name" required />
                    </div>
                    <div class="form-group">
                        <label for="Email">Email</label>
                        <input id="Email" class="form-control" type="email" name="Input.Email" value="@Model.Input?.Email" placeholder="name@example.com" autocomplete="username" required />
                    </div>
                    <div class="form-group">
                        <label for="Password">Password</label>
                        <input id="Password" class="form-control" type="password" name="Input.Password" placeholder="Upper and lower case letters and a digit" autocomplete="new-password" required />
                    </div>
                    <div class="form-group">
                        <label for="ConfirmPassword">Confirm password</label>
                        <input id="ConfirmPassword" class="form-control" type="password" name="Input.ConfirmPassword" placeholder="Repeat the password" autocomplete="new-password" required />
                    </div>
                    <div class="form-group form-check">
                        <input id="AcceptAgreement" class="form-check-input" type="checkbox" name="Input.AcceptAgreement" value="true" onchange="document.getElementById('RegisterButton').disabled = !this.checked" />
                        <label class="form-check-label" for="AcceptAgreement">I accept the terms of the agreement</label>
                    </div>
                    <button id="RegisterButton" type="submit" class="btn btn-primary btn-block" disabled><i class="fas fa-user-plus mr-1" aria-hidden="true"></i> Create account</button>
                </form>
                <p class="text-center mt-3 mb-0">
                    Already have an account?
                    <a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
                </p>
            </div>
        </div>
    </div>
</div>
