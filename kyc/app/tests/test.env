# Keycloak on its embedded H2 database, for the tests only
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=123456
KC_DB=dev-file
KC_HOSTNAME=http://kyc-proxy:5000
KC_HTTP_PORT=8080
KC_PROXY_HEADERS=xforwarded
KC_HEALTH_ENABLED=true
BANK_CLIENT_SECRET=bank-test-secret
SHOP_CLIENT_SECRET=shop-test-secret

# Redis, where the scenarios keep their sessions
REDIS_PASSWORD=kyc-test-redis
REDIS_URL=redis://:kyc-test-redis@kyc-redis:6379/0
