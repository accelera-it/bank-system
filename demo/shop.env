# Environment of demo/docker-compose.yml. Development defaults only: do not put real secrets here.

# PostgreSQL
POSTGRES_DB=DemoShop
POSTGRES_USER=demoshop
POSTGRES_PASSWORD=Ab17f9b40f9b28672ab9b43

# Redis
REDIS_PASSWORD=Ab1c07bc14a46530d55c686

# DemoShop
ConnectionStrings__DemoShop="Host=pg;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
ConnectionStrings__Redis="shop-redis:6379,password=${REDIS_PASSWORD}"

# Direct payments through CentralApi
